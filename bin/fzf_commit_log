#!/usr/bin/env zsh

_fzf_commit_log () {
	git log --graph --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" | fzf --ansi --no-sort --reverse --tiebreak=index --bind=ctrl-r:toggle-sort --bind "ctrl-m:execute:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                xargs -I % sh -c 'git show --color=always % | $PAGER') << 'FZF-EOF'
                {}
FZF-EOF"
}

_fzf_commit_log "$@"
