" ------------------------------------------------------------------------------
" Sample keyboard mappings
" ------------------------------------------------------------------------------

" Quit vifm
nnoremap <C-w>q :wq<cr>
nnoremap <C-w>Q :q!<cr>
nnoremap \q :wq<cr>
nnoremap qq :wq<cr>
nnoremap \1 :only<cr>

" Show hidden/dot files
nnoremap . za

" Make file executable
nnoremap * :!chmod +x %f<cr>
nnoremap gm :chmod<cr>

" Start shell in current directory
nnoremap s :shell<cr>

" Display sorting dialog
nnoremap S :sort<cr>

" Toggle visibility of preview window
nnoremap w :view<cr>
vnoremap w :view<cr>gv

" Open file in new neovide window
nnoremap O :!neovide %f<cr>

" Open file in the background using its default program
nnoremap gb :!open -g %f<cr>

" Yank current directory path into the clipboard
nnoremap yd :!printf %d | pbcopy<cr>

" Yank current file path into the clipboard (escape spaces)
nnoremap yf :!printf %f:p:gs? ?\\ ? | pbcopy<cr>

" View preview in Quick Look
nnoremap <space> :!qlmanage -p %f > /dev/null 2>&1<cr>

" Mappings for faster renaming
" nnoremap I cw<c-a>
" nnoremap cc cw<c-u>
" nnoremap A cw

" As above, but without the file extension
nnoremap I cW<c-a>
nnoremap cc cW<c-u>
nnoremap A cW
nnoremap R :rename<cr>

" Open editor to edit vifmrc and apply settings after returning to vifm
nnoremap ,c :write | edit $MYVIFMRC | restart full<cr>

" Open neovide to edit vifmrc
nnoremap ,C :!neovide $MYVIFMRC<cr>

" Toggle wrap setting on ,w key
nnoremap ,w :set wrap!<cr>

" Example of standard two-panel file managers mappings
nnoremap <f3> :!less %f<cr>
nnoremap <f4> :edit<cr>
nnoremap <f5> :copy<cr>
nnoremap <f6> :move<cr>
nnoremap <f7> :mkdir<space>
nnoremap <f8> :delete<cr>

" Midnight commander alike mappings
" Open current directory in the other pane
nnoremap <a-i> :sync<cr>
" Open directory under cursor in the other pane
nnoremap <a-o> :sync %c<cr>
" Swap panes (uncomment if you don't need builtin behaviour of Ctrl-U)
nnoremap <c-u> <c-w>x

" ------------------------------------------------------------------------------
" Panel configuration examples
" ------------------------------------------------------------------------------

" Customize view columns a bit (enable ellipsis for truncated file names)
" set viewcolumns=-{name}..,6{}.
" set viewcolumns=-{name}..,8{size}..,18{mtime}

" Set initial state
let $VIEW_MODE = 'simple'
set viewcolumns=-{name}..

" Toggle mapping: Press 'cc' to switch views
nnoremap gd :if $VIEW_MODE == 'detail' |
            \ set viewcolumns=-{name}.. |
            \ let $VIEW_MODE = 'simple' |
            \ else |
            \ set viewcolumns=-{name}..,10{size}..,18{mtime} |
            \ let $VIEW_MODE = 'detail' |
            \ endif<cr>

 set fillchars=vborder:┃,hborder:━

" Filter-out build artifacts and temporary files
 "filter! {*.lo,*.o,*.d,*.class,*.pyc,*.pyo,.*~}

