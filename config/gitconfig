# vim:ft=gitconfig

[alias]
  co = checkout
  count = shortlog -sn
  now = status --short --branch
  last = log -1 --oneline --patch
  root = rev-parse --show-toplevel
  unstage = reset HEAD --
  wt-new = "!f() { git worktree add ../$1 -b $1 $2 && cd ../$1 && git push -u origin HEAD; }; f"
  wt-done = "!f() { git worktree remove \"../$1\" && git branch -d \"$1\" && git fetch --prune; }; f"
  ui = !gitui
  sm = !smerge
  lg = !lazygit --debug --screen-mode=half
  fzg = !fzf_commit_log
  fzp = !fzf_commit_preview
[apply]
  whitespace = nowarn
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  pager = true
  ui = true
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[core]
  excludesfile = ~/.gitignore
  editor = nvim
  pager = delta
[credential]
  # helper = osxkeychain
  credentialStore = gpg
  helper = "/opt/homebrew/bin/gh auth git-credential"
[credential "https://github.com"]
  helper = cache --timeout=3600
  username = kuntau
[delta]
  diff-highlight = false
  diff-so-fancy = true
  features = unobtrusive-line-numbers decorations
  # features = calochortus-lyallii
  navigate = true
  side-by-side = false
  true-color = always
  whitespace-error-style = 22 reverse
[delta "unobtrusive-line-numbers"]
  line-numbers = true
  line-numbers-minus-style = "#444444"
  line-numbers-zero-style = "#444444"
  line-numbers-plus-style = "#444444"
  line-numbers-left-format = "{nm:>4}┊"
  line-numbers-right-format = "{np:>4}│"
  line-numbers-left-style = blue
  line-numbers-right-style = blue
[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = yellow box
[filter "media"]
  clean = git-media-clean %f
  smudge = git-media-smudge %f
[giggle]
  main-window-maximized = false
  main-window-geometry = 794x848+0+900
  history-view-vpane-position = 675
  file-view-vpane-position = 654
  main-window-view = FileView
[help]
  autocorrect = 1
[hub]
  protocol = https
[include]
  path = ~/dotfiles/config/delta/themes.gitconfig
[interactive]
  diffFilter = delta --color-only
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoStash = true
  autosquash = true
  updateRefs = true
[pull]
  ff = only
  rebase = true
[push]
  default = current
  autoSetupRemote = true
  followTags = true
[user]
  email = kuntau17@gmail.com
	name = Kuntau
  signingkey = DFBA935E336840CA
[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
[credential "https://dev.azure.com"]
  useHttpPath = true
[gpg]
  format = ssh
[transfer]
  fsckObjects = true
[fetch]
  fsckObjects = true
  prune = true
  pruneTags = true
[receive]
  fsckObjects = true
[status]
  submodulesummary = true
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = master
[help]
  autocorrect = prompt
[diff]
  colorMoved = default
	tool = vscode-diff
	guitool = Kaleidoscope
  algorithm = histogram
  submodule = log
  renames = true
  mnemonicPrefix = true
[difftool]
  guiDefault = false
  hideResolved = true  # https://www.eseth.org/2020/mergetools.html
	prompt = false
	trustExitCode = true
[merge]
  conflictstyle = zdiff3
	tool = vscode-diff
	guitool = Kaleidoscope
[mergetool]
  guiDefault = false
  keepBackup = false
	prompt = false
[difftool "smerge"]
  cmd = smerge \"$BASE\" \"$LOCAL\" \"$REMOTE\"
[mergetool "smerge"]
  cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
  trustExitCode = true
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[difftool "meld"]
    cmd = open -W -a Meld --args \"$LOCAL\" \"$REMOTE\"
[mergetool "meld"]
    cmd = open -W -a Meld --args --auto-merge \"$LOCAL\" \"$BASE\" \"$REMOTE\" --output=\"$MERGED\"
[difftool "vscode-diff"]
	cmd = nvim -c \"CodeDiff file \"$LOCAL\" \"$REMOTE\"\"
  # cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[mergetool "vscode-diff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\"
[difftool "nvim_difftool"]
  cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"
