# Font Size
font-size = 12.5

font-family = "Maple Mono"
font-family-bold = "Operator Mono"
font-family-italic = "Cascadia Code"
font-family-bold-italic = "MonoLisa"

# Fallback for symbols / nerd glyphs
font-family = "Symbols Nerd Font Mono"

font-feature = "MonoLisa:+ss01,+ss02,+ss07,+ss09,+ss11,+ss14,-calt,+zero"
font-feature = "Operator Mono:+ss01,+ss07,+ss11,+zero"
font-feature = "Maple Mono:+calt,+liga,+ss01,+ss02,+ss03,+zero"
font-feature = "Cascadia Code:+ss01,+ss02,+ss03,+calt,+ss19,+ss20,+zero"

adjust-cell-height = +10%
theme = light:catppuccin-latte,dark:ayu mirage
focus-follows-mouse = false
confirm-close-surface = true
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 1m

window-save-state = always
window-subtitle = false
window-theme = auto
window-vsync = true
window-padding-x = 0
window-padding-y = 0
auto-update = check

# macos-titlebar-style: tabs = good, hidden = hide all chrome except rounded corder
macos-titlebar-style = hidden 
macos-icon = xray
# window-decoration: auto, false, none
window-decoration = auto 
background-opacity = .95
