# Font Size
font-size = 12

# Font Family: Ghostty processes this from left to right for fallbacks
font-family = "MonoLisa, Operator Mono, Cascadia Code, Maple Mono, Symbols Nerd Font"

# Font style
font-style = Book

# Scoped Font Features
font-feature = "MonoLisa:+ss01,+ss02,+ss07,+ss09,+ss11,+ss14,-calt"
font-feature = "Operator Mono:+ss01,+ss07,+ss11"
font-feature = "Cascadia Code:+ss01,+ss02,+ss03,+calt,+ss19,+ss20"
font-feature = "Maple Mono:+calt,+liga,+ss01,+ss02,+ss03"

adjust-cell-height = +10%
theme = light:dawnfox,dark:ayu mirage
focus-follows-mouse = false
confirm-close-surface = true
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 1m
# tabs = good, hidden = hide all chrome except rounded corder
macos-titlebar-style = hidden
macos-icon = xray
# auto, false, none
window-decoration = auto
window-save-state = always
window-subtitle = false
window-theme = auto
window-vsync = true
window-padding-x = 0
window-padding-y = 0
auto-update = check
